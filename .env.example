# Database
# Use a managed MySQL/MariaDB URL in production.
# If your password contains special characters, URL-encode them, e.g. @ becomes %40.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/trustlayer"

# API sessions: signs the cookie issued after a wallet signs the sign-in message.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; local dev falls back to a per-process random secret.
SESSION_SECRET="replace-with-64-hex-chars"

# Web3Auth / Chain
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID="replace-with-web3auth-client-id"
NEXT_PUBLIC_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
# Optional server-side RPC used to check escrow jobs on-chain (defaults to the public Amoy RPC).
AMOY_RPC_URL="https://rpc-amoy.polygon.technology/"

# Reclaim
APPLICATION_ID="replace-with-reclaim-application-id"
APPLICATION_SECRET="replace-with-reclaim-application-secret"
NEXT_PUBLIC_RECLAIM_PROVIDER_ID="replace-with-reclaim-provider-id"
NEXT_PUBLIC_RECLAIM_APP_ID="replace-with-reclaim-app-id"

# Contract deployer key, used only by smart_contracts/scripts/deploy.js. Never commit a real key.
PRIVATE_KEY="replace-with-deployer-private-key"
